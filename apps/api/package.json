{
  "name": "@atlas/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b",
    "test": "node --test"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,json",
    "exec": "node src/server.ts"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "string-width": "^9.0.0",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "nodemon": "^3.1.14"
  }
}
