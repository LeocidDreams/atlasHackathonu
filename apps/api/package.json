{
  "name": "@atlas/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -b tsconfig.app.json && tsc-alias -p tsconfig.app.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b",
    "test": "vitest"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js,json",
    "env": {
      "NODE_ENV": "development"
    },
    "exec": "pnpm run build && node dist/index.js"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "@langchain/core": "^1.4.1",
    "@langchain/textsplitters": "^1.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "chalk": "^6.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fast-glob": "^3.3.3",
    "helmet": "^8.3.0",
    "langchain": "^1.6.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "string-width": "^9.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "tsc-alias": "^1.9.10",
    "vitest": "^5.1.0"
  }
}
